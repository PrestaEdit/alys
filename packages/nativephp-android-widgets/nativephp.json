{
    "namespace": "AndroidWidgets",
    "bridge_functions": [
        {
            "name": "Widget.Update",
            "android": "com.nativephp.androidwidgets.WidgetFunctions.Update",
            "description": "Update all home screen widgets with new data (title, content, badge)"
        }
    ],
    "android": {
        "min_version": 26,
        "permissions": [],
        "dependencies": {
            "implementation": []
        },
        "receivers": [
            {
                "name": "com.nativephp.androidwidgets.NativeWidgetProvider",
                "exported": true,
                "intent-filters": [
                    {
                        "action": "android.appwidget.action.APPWIDGET_UPDATE"
                    }
                ],
                "meta-data": [
                    {
                        "name": "android.appwidget.provider",
                        "resource": "@xml/nativephp_widget_info"
                    }
                ]
            }
        ]
    },
    "ios": {
        "min_version": "18.2"
    }
}
