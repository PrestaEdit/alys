{
    "name": "prestaedit/nativephp-android-widgets",
    "version": "1.0.0",
    "description": "NativePHP plugin to create and update Android home screen widgets",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "NativePhp\\AndroidWidgets\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NativePhp\\AndroidWidgets\\AndroidWidgetsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
